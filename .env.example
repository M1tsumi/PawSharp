# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit it.
#
# Local setup:
#   1. cp .env.example .env
#   2. Fill in DISCORD_TOKEN below
#   3. Load before running: $env:DISCORD_TOKEN = "Bot ..."   (PowerShell)
#                           export DISCORD_TOKEN="Bot ..."   (bash)
#      Or use a tool like DotNetEnv: DotNetEnv.Env.Load();
#
# CI setup: add DISCORD_TOKEN as a GitHub Actions secret / repository secret.
# Never log the token value. Never hardcode it in source files.

DISCORD_TOKEN=Bot YOUR_BOT_TOKEN_HERE

# Optional: Redis connection string for distributed caching (see RedisCacheExample)
# REDIS_CONNECTION=localhost:6379
