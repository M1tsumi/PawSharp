# Normalise line endings to LF for all text files on checkout.
# Windows developers using Git for Windows will get CRLF in their working tree
# (via core.autocrlf=true) but the repository always stores LF.
* text=auto eol=lf

# C# source and project files
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.config    text eol=lf

# Markup / data
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf

# Scripts
*.sh        text eol=lf
*.py        text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary assets — never diff or merge
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
*.eot    binary
*.nupkg  binary
*.snupkg binary
*.dll    binary
*.exe    binary
*.pdb    binary
