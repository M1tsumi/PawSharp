{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/PawSharp.Core/bin/Release/net10.0/PawSharp.Core.dll",
            "src/PawSharp.API/bin/Release/net10.0/PawSharp.API.dll",
            "src/PawSharp.Gateway/bin/Release/net10.0/PawSharp.Gateway.dll",
            "src/PawSharp.Cache/bin/Release/net10.0/PawSharp.Cache.dll",
            "src/PawSharp.Client/bin/Release/net10.0/PawSharp.Client.dll",
            "src/PawSharp.Commands/bin/Release/net10.0/PawSharp.Commands.dll",
            "src/PawSharp.Interactions/bin/Release/net10.0/PawSharp.Interactions.dll",
            "src/PawSharp.Interactivity/bin/Release/net10.0/PawSharp.Interactivity.dll",
            "src/PawSharp.Voice/bin/Release/net10.0/PawSharp.Voice.dll"
          ],
          "src": "."
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "filter": "filterConfig.yml",
      "namespaceLayout": "nested",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "docs/guides/**.md",
          "toc.yml",
          "index.md",
          "CHANGELOG.md",
          "CONTRIBUTING.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "PawSharp",
      "_appName": "PawSharp",
      "_appFooter": "PawSharp 1.1.0-alpha.5 &mdash; MIT License &mdash; <a href='https://github.com/M1tsumi/PawSharp'>GitHub</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_favicon": "assets/pawsharp-logo.svg",
      "_gitContribute": {
        "repo": "https://github.com/M1tsumi/PawSharp",
        "branch": "develop"
      }
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "modern"
    ],
    "postProcessors": ["ExtractSearchIndex"],
    "markdownEngineName": "markdig",
    "noDryRun": false
  }
}
