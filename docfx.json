{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/PawSharp.Core/PawSharp.Core.csproj",
            "src/PawSharp.API/PawSharp.API.csproj",
            "src/PawSharp.Gateway/PawSharp.Gateway.csproj",
            "src/PawSharp.Cache/PawSharp.Cache.csproj",
            "src/PawSharp.Client/PawSharp.Client.csproj",
            "src/PawSharp.Commands/PawSharp.Commands.csproj",
            "src/PawSharp.Interactions/PawSharp.Interactions.csproj",
            "src/PawSharp.Interactivity/PawSharp.Interactivity.csproj",
            "src/PawSharp.Voice/PawSharp.Voice.csproj"
          ],
          "src": "."
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "filter": "filterConfig.yml",
      "namespaceLayout": "nested",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "PawSharp",
      "_appName": "PawSharp",
      "_appFooter": "PawSharp 0.11.0-alpha.1 &mdash; MIT License &mdash; <a href='https://github.com/M1tsumi/PawSharp'>GitHub</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/M1tsumi/PawSharp",
        "branch": "main"
      }
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "modern"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noDryRun": false
  }
}
