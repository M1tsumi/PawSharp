<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PawSharp.API</RootNamespace>
    <AssemblyName>PawSharp.API</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>PawSharp.API</PackageId>
    <Version>1.0.0-alpha.2</Version>
    <Authors>PawSharp Team</Authors>
    <Company>PawSharp</Company>
    <Description>REST API client for PawSharp Discord API wrapper with automatic rate limiting and error handling.</Description>
    <PackageTags>discord;api;bot;wrapper;rest;rate-limiting</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/M1tsumi/Pawsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PawSharp.Core\PawSharp.Core.csproj" />
  </ItemGroup>

</Project>
