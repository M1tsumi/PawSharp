<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PawSharp.Cache</RootNamespace>
    <AssemblyName>PawSharp.Cache</AssemblyName>
    <PackageId>PawSharp.Cache</PackageId>
    <Version>1.0.0-alpha.2</Version>
    <Authors>PawSharp Team</Authors>
    <Company>PawSharp</Company>
    <Description>Caching providers for PawSharp with in-memory and pluggable cache implementations.</Description>
    <PackageTags>discord;api;bot;wrapper;cache;caching</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/M1tsumi/Pawsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PawSharp.Core\PawSharp.Core.csproj" />
    <ProjectReference Include="..\PawSharp.API\PawSharp.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
