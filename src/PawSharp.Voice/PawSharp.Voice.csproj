<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PawSharp.Voice</RootNamespace>
    <AssemblyName>PawSharp.Voice</AssemblyName>
    <PackageId>PawSharp.Voice</PackageId>
    <Version>0.9.0-alpha.1</Version>
    <Authors>PawSharp Team</Authors>
    <Company>PawSharp</Company>
    <Description>Voice support for PawSharp (experimental - basic voice connection and heartbeat).</Description>
    <PackageTags>discord;api;bot;wrapper;voice;experimental</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/M1tsumi/Pawsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PawSharp.Core\PawSharp.Core.csproj" />
    <ProjectReference Include="..\PawSharp.API\PawSharp.API.csproj" />
    <ProjectReference Include="..\PawSharp.Gateway\PawSharp.Gateway.csproj" />
    <ProjectReference Include="..\PawSharp.Client\PawSharp.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="1.0.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
