<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PawSharp.Client</RootNamespace>
    <AssemblyName>PawSharp.Client</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>PawSharp.Client</PackageId>
    <Version>0.5.0-alpha13</Version>
    <Authors>PawSharp Team</Authors>
    <Company>PawSharp</Company>
    <Description>Main Discord client for PawSharp with unified API, gateway, and caching.</Description>
    <PackageTags>discord;api;bot;wrapper;client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/your-org/PawSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PawSharp.Core\PawSharp.Core.csproj" />
    <ProjectReference Include="..\PawSharp.API\PawSharp.API.csproj" />
    <ProjectReference Include="..\PawSharp.Gateway\PawSharp.Gateway.csproj" />
    <ProjectReference Include="..\PawSharp.Cache\PawSharp.Cache.csproj" />
    <ProjectReference Include="..\PawSharp.Interactions\PawSharp.Interactions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
