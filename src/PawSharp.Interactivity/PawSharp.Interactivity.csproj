<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PawSharp.Interactivity</RootNamespace>
    <AssemblyName>PawSharp.Interactivity</AssemblyName>
    <PackageId>PawSharp.Interactivity</PackageId>
    <Version>0.5.0-alpha11</Version>
    <Authors>PawSharp Team</Authors>
    <Company>PawSharp</Company>
    <Description>Interactivity framework for PawSharp with pagination, polls, and user input collection.</Description>
    <PackageTags>discord;api;bot;wrapper;interactivity;pagination;polls</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/your-org/PawSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PawSharp.Core\PawSharp.Core.csproj" />
    <ProjectReference Include="..\PawSharp.Client\PawSharp.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
